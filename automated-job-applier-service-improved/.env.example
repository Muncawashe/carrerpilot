# Copy to .env.local (local) or paste into Vercel > Settings > Environment Variables.

# Required: password you type in the app before it will send email (pick a long random string)
APP_ACCESS_KEY=change-me-to-a-long-random-string

# Required: SMTP login. Gmail: enable 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and paste the 16 characters below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password

# Sender details
MAIL_FROM_NAME=Tinotenda Chivhera
MAIL_REPLY_TO=your.address@gmail.com
# true = blind-copy yourself on every application
MAIL_BCC_SELF=true

# Default CV attached to every application (put the file in ./private/)
CV_PATH=private/cv.pdf
CV_FILENAME=Tinotenda_Chivhera_CV.pdf

# Safety cap on emails sent per hour
MAX_APPLICATIONS_PER_HOUR=15
